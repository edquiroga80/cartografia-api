# =============================================================================
# CartografIA API — Variables de entorno
# Renombrar a .env y completar valores
# =============================================================================

# Servidor
HOST=0.0.0.0
PORT=8000

# CORS — dominios permitidos (separados por coma)
# Para producción: reemplazar con el dominio real de tu app Lovable
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.lovable.app","https://*.gisdev.ar"]

# Directorios de trabajo
OUTPUT_DIR=/tmp/cartografia_outputs
UPLOAD_DIR=/tmp/cartografia_uploads
DEM_CACHE_DIR=/tmp/dem_cache

# Supabase (opcional — para sincronizar estado de jobs)
# Si no se configura, el estado se mantiene solo en memoria del proceso
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Logo institucional (ruta absoluta al .png en el servidor)
LOGO_PATH=

# Límites de seguridad
MAX_AOI_AREA_DEG2=25.0
JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=3
